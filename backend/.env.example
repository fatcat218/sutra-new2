# ---------------------------------------------------------------------------
# Sutra backend — environment variables
# Copy this file to ".env" and fill in real values. DO NOT commit .env.
# ---------------------------------------------------------------------------

# Local SQLite is supported for lightweight development. For Supabase, use the
# Session pooler URL from the project's Connect dialog.
DATABASE_URL=sqlite:///./sutra_local.db

# Supabase Auth configuration. The publishable key is safe for browser use;
# never put a Supabase secret key in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Which external AI provider to use: openai | openrouter | gemini | claude
AI_PROVIDER=openrouter

# API key for the chosen provider. NEVER hardcode this in source.
AI_API_KEY=your_api_key_here

# Optional: override the default model for the chosen provider.
# openrouter default: openrouter/auto | openai default: gpt-4o-mini
# gemini default: gemini-1.5-flash | claude default: claude-3-5-sonnet-latest
# AI_MODEL=

# The frontend origin allowed by CORS (the Sutra landing/app URL).
FRONTEND_URL=http://localhost:3000
